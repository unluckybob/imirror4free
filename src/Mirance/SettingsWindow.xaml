<Window x:Class="Mirance.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" 
        Height="500" Width="450"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#1E1E1E">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Capture Settings -->
                <TextBlock Text="Capture" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <TextBlock Text="Max FPS:" Margin="0,5,0,5"/>
                <ComboBox x:Name="cboMaxFPS" SelectedIndex="1">
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="60"/>
                    <ComboBoxItem Content="120"/>
                </ComboBox>
                
                <CheckBox x:Name="chkVSync" Content="VSync" Margin="0,10,0,5"/>
                <CheckBox x:Name="chkAutoReconnect" Content="Auto Reconnect" Margin="0,0,0,5"/>
                <CheckBox x:Name="chkAutoInstallDriver" Content="Auto Install Driver" Margin="0,0,0,5"/>
                
                <!-- Audio Settings -->
                <TextBlock Text="Audio" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                
                <CheckBox x:Name="chkEnableAudio" Content="Enable Audio" Margin="0,0,0,5"/>
                
                <TextBlock Text="Sample Rate:" Margin="0,5,0,5"/>
                <ComboBox x:Name="cboSampleRate" SelectedIndex="0">
                    <ComboBoxItem Content="44100"/>
                    <ComboBoxItem Content="48000"/>
                    <ComboBoxItem Content="96000"/>
                </ComboBox>
                
                <!-- Display Settings -->
                <TextBlock Text="Display" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                
                <CheckBox x:Name="chkStartFullscreen" Content="Start Fullscreen" Margin="0,0,0,5"/>
                <CheckBox x:Name="chkAlwaysOnTop" Content="Always On Top" Margin="0,0,0,5"/>
                <CheckBox x:Name="chkShowFPS" Content="Show FPS Overlay" Margin="0,0,0,5"/>
                
                <!-- Recording Settings -->
                <TextBlock Text="Recording" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                
                <TextBlock Text="Video Bitrate:" Margin="0,5,0,5"/>
                <ComboBox x:Name="cboVideoBitrate" SelectedIndex="1">
                    <ComboBoxItem Content="4000000 (4 Mbps)"/>
                    <ComboBoxItem Content="8000000 (8 Mbps)"/>
                    <ComboBoxItem Content="16000000 (16 Mbps)"/>
                </ComboBox>
                
                <TextBlock Text="Save to:" Margin="0,10,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtRecordPath" Grid.Column="0" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="..." Width="30" Click="BtnBrowse_Click"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Width="80" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Click="BtnCancel_Click" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>