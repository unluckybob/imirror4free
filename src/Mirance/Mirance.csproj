<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Mirance</AssemblyName>
    <RootNamespace>Mirance</RootNamespace>
    <Version>1.0.0</Version>
    <Description>iPhone Screen Mirroring - Exact replica of AnyMiro</Description>
    <Copyright>2024</Copyright>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SharpDX - matches AnyMiro's embedded DLLs -->
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
    <PackageReference Include="SharpDX.XAudio2" Version="4.2.0" />
    
    <!-- USB - LibUsbDotNet 2.x -->
    <PackageReference Include="LibUsbDotNet" Version="2.2.8" />
    
    <!-- Audio - Same as AnyMiro -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    
    <!-- FFmpeg - Same as AnyMiro -->
    <PackageReference Include="FFMpegCore" Version="5.1.0" />
    
    <!-- JSON - Same as AnyMiro -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    
    <!-- Logging - Same as AnyMiro -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

</Project>
