<Window x:Class="Mirance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mirance" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="800"
        WindowStyle="SingleBorderWindow"
        Background="#1E1E1E"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>
        
        <!-- Toolbar - Same layout as AnyMiro -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Device selector -->
                <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="cboDevices" Width="200" Height="28"/>
                <Button x:Name="btnRefresh" Content="⟳" Width="32" Height="28" 
                        Click="BtnRefresh_Click" Margin="8,0,0,0" ToolTip="Refresh devices"/>
                
                <Separator Margin="20,0"/>
                
                <!-- Capture controls -->
                <Button x:Name="btnConnect" Content="Connect" Width="80" Height="28" 
                        Click="BtnConnect_Click" IsEnabled="False"/>
                <Button x:Name="btnScreenshot" Content="Screenshot" Width="80" Height="28" 
                        Click="BtnScreenshot_Click" IsEnabled="False" Margin="8,0,0,0"/>
                <Button x:Name="btnRecord" Content="Record ●" Width="80" Height="28" 
                        Click="BtnRecord_Click" IsEnabled="False" Margin="8,0,0,0"/>
                
                <Separator Margin="20,0"/>
                
                <!-- Display options -->
                <Button x:Name="btnFullscreen" Content="⛶ Fullscreen" Width="90" Height="28" 
                        Click="BtnFullscreen_Click"/>
                <CheckBox x:Name="chkVsync" Content="VSync" IsChecked="True" 
                          Foreground="White" VerticalAlignment="Center" Margin="20,0,0,0"/>
                <CheckBox x:Name="chkAudio" Content="Audio" IsChecked="True" 
                          Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                
                <Separator Margin="20,0"/>
                
                <!-- Settings -->
                <Button x:Name="btnSettings" Content="⚙" Width="32" Height="28" 
                        Click="BtnSettings_Click"/>
            </StackPanel>
        </Border>
        
        <!-- Main rendering area - WPF hosts SharpDX Direct3D via D3DImage -->
        <!-- EXACT same rendering approach as AnyMiro's DrawPanel.UI -->
        <Border Grid.Row="1" Background="Black" Margin="10" BorderBrush="#444" BorderThickness="1">
            <!-- SharpDX renders into this D3DImage - matches AnyMiro's rendering -->
            <Image x:Name="RenderSurface" Stretch="Uniform"/>
        </Border>
        
        <!-- Status bar -->
        <Border Grid.Row="2" Background="#2D2D2D" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="txtStatus" Grid.Column="0" Text="Disconnected" 
                           Foreground="#888" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtFPS" Grid.Column="1" Text="" Foreground="#0F0" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="txtResolution" Grid.Column="2" Text="" Foreground="#888" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
                <TextBlock x:Name="txtBitrate" Grid.Column="3" Text="" Foreground="#88F" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>