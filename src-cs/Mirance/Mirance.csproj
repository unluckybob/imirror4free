<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>Mirance</AssemblyName>
    <RootNamespace>Mirance</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Mirance Team</Authors>
    <Product>Mirance</Product>
    <Description>iPhone Screen Mirroring for Windows - Built like AnyMiro</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- DirectX 11 - Same as AnyMiro's Core.MD.Render.dll -->
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct2D1" Version="4.2.0" />
    
    <!-- USB - Same as AnyMiro's Core.Connection.dll -->
    <PackageReference Include="LibUsbDotNet" Version="1.9.0" />
    
    <!-- JSON - Same as AnyMiro's Core.Json.dll -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>